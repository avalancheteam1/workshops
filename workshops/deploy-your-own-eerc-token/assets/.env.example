# Copy to .env in the root of your EncryptedERC clone. Never commit the filled-in file.
# Use dedicated test accounts. Never a wallet that holds real funds.

# Two funded Fuji accounts, with the 0x prefix.
# Account 1 deploys, becomes the auditor, mints and sends. Account 2 receives.
PRIVATE_KEY=0x...
PRIVATE_KEY_2=0x...

# Fuji C-Chain RPC. Used by the `fuji` network entry you add to hardhat.config.ts.
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Token metadata, read by scripts/deploy.ts.
EERC_NAME=CollegeToken
EERC_SYMBOL=CLGT
EERC_DECIMALS=2

# Filled in after deploy.ts prints them.
REGISTRAR=
ENCRYPTED_ERC=
