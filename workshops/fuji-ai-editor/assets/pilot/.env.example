# No private keys, seed phrases, passwords or API keys are used by this pilot.
# Optional local ledger directory; default is ~/.team1-fuji-pilot.
# TEAM1_PILOT_STATE_DIR=/absolute/path/to/private-local-state
# Default RPC is fixed to Avalanche Fuji. This override accepts loopback only,
# for synthetic development tests; it does not enable mainnet.
# TEAM1_PILOT_RPC=http://127.0.0.1:8545
